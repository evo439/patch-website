---
import BaseLayout from "../layouts/BaseLayout.astro";
import Shows from "../components/Shows.astro";
import BandMembers from "../components/BandMembers.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config/theme.config.ts";
import { getCollection } from "astro:content";

let pageData = null;
try {
  const pages = await getCollection("pages");
  pageData = pages.find((p) => p.id === "home")?.data;
} catch {}

const title = pageData?.title || SITE.name;
const subtitle = pageData?.subtitle || "Dutch Melodic Rock";
const heroTagline = pageData?.heroTagline || "A melodic rock project, created and arranged by creative and seasoned musicians from the Netherlands.";
const description = pageData?.description || SITE.description;
---

<BaseLayout
  title={`${title} - Melodic Rock Project`}
  description={description}
  canonical="/"
  flushFooter
>
  <!-- Hero Section -->
  <section class="relative -mt-[calc(4rem+2px)] min-h-[85vh] overflow-hidden border-b border-border/60 pt-[calc(4rem+2px)] flex items-center justify-center">
    <!-- Hero Image Background -->
    <div class="absolute inset-0 h-full w-full bg-neutral-950">
      <img
        src="/images/band/patch-hero-banner.webp"
        alt="P‡TCH Live Band Banner"
        class="h-full w-full object-cover object-center opacity-70"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Gradient Overlays for Readability -->
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-background via-background/80 to-transparent"
    ></div>

    <div class="relative mx-auto max-w-6xl px-5 py-24 sm:py-32 w-full">
      <div class="max-w-3xl text-white">
        <span class="inline-block rounded-full bg-primary/20 px-3.5 py-1 text-xs font-semibold uppercase tracking-widest text-primary border border-primary/40 backdrop-blur-sm">
          {subtitle}
        </span>

        <h1 class="mt-4 font-serif text-5xl font-extrabold tracking-tight sm:text-7xl lg:text-8xl drop-shadow-lg text-white">
          {title}
        </h1>

        <p class="mt-6 text-lg sm:text-xl md:text-2xl text-neutral-200 leading-relaxed font-light drop-shadow">
          {heroTagline}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/music"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-primary-foreground transition-transform hover:scale-105 hover:bg-primary/90 shadow-lg shadow-primary/25"
          >
            Listen & Watch
            <Icon name="chevron-right" class="h-4 w-4" />
          </a>
          <a
            href="/shows"
            class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/20 hover:border-white/50"
          >
            Tour Dates
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Band Members Component -->
  <BandMembers />

  <!-- Tour Dates Teaser Component -->
  <Shows
    limit={3}
    title="Upcoming Concerts"
    subtitle="Catch P‡TCH live on stage across the Netherlands and Europe."
  />
</BaseLayout>
