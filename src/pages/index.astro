---
import BaseLayout from "../layouts/BaseLayout.astro";
import Shows from "../components/Shows.astro";
import BandMembers from "../components/BandMembers.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config/theme.config.ts";
---

<BaseLayout
  title={`${SITE.name} - Melodic Rock Project`}
  description={SITE.description}
  canonical="/"
  flushFooter
>
  <!-- Hero Section -->
  <section class="relative -mt-[calc(4rem+2px)] min-h-[85vh] overflow-hidden border-b border-border/60 pt-[calc(4rem+2px)] flex items-center justify-center">
    <!-- Hero Image Background -->
    <div class="absolute inset-0 h-full w-full bg-neutral-950">
      <img
        src="/images/band/patch-hero-banner.webp"
        alt="P‡TCH Live Band Banner"
        class="h-full w-full object-cover object-center opacity-70"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Gradient Overlays for Readability -->
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30"
    ></div>
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-background via-background/80 to-transparent"
    ></div>

    <div class="relative mx-auto max-w-6xl px-5 py-24 sm:py-32 w-full">
      <div class="max-w-3xl text-white">
        <span class="inline-block rounded-full bg-primary/20 px-3.5 py-1 text-xs font-semibold uppercase tracking-widest text-primary border border-primary/40 backdrop-blur-sm">
          Dutch Melodic Rock
        </span>

        <h1 class="mt-4 font-serif text-5xl font-extrabold tracking-tight sm:text-7xl lg:text-8xl drop-shadow-lg text-white">
          P‡TCH
        </h1>

        <p class="mt-6 text-lg sm:text-xl font-normal leading-relaxed text-white/90 drop-shadow max-w-2xl">
          P‡TCH is a melodic rock project, created and arranged by creative and seasoned musicians from the Netherlands. Sharp, distinguishing guitar & bass lines combined with a raw driving voice and intense lyrics.
        </p>

        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <a
            href="/shows"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-foreground px-6 py-3.5 text-sm font-semibold text-background hover:opacity-90 transition-all shadow-lg text-center"
          >
            Upcoming Shows
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href="/music"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-white/40 bg-white/10 backdrop-blur-md px-6 py-3.5 text-sm font-semibold text-white hover:bg-white/20 transition-all text-center"
          >
            Listen & Watch
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Shows Preview Section -->
  <Shows
    showUpcomingOnly
    limit={3}
    title="Upcoming Live Shows"
    subtitle="Join P‡TCH live at our upcoming concert dates."
  />

  <div class="bg-muted/20 border-b border-border/60 py-6 text-center">
    <a href="/shows" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
      View full concert schedule & past archive <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>

  <!-- We Are P‡TCH Section -->
  <BandMembers />
</BaseLayout>
