---
import Icon from "./Icon.astro";
import { SITE, NAVIGATION } from "../config/theme.config.ts";
import { getCollection } from "astro:content";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const activeClass = "text-foreground font-semibold";
const inactiveClass = "text-muted-foreground transition-colors hover:text-foreground";
const headerClass = "sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md";
const iconClass = "inline-flex h-10 w-10 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";

let pagesList = [];
try {
  pagesList = await getCollection("pages");
} catch {
  pagesList = [];
}

const allNavItems = pagesList.length > 0
  ? pagesList
      .filter((page) => page.data?.showInNav !== false)
      .sort((a, b) => (a.data.navOrder ?? 10) - (b.data.navOrder ?? 10))
      .map((page) => ({
        label: page.id === "home" && page.data.title === "P‡TCH" ? "Home" : page.data.title,
        to: page.id === "home" ? "/" : `/${page.id}`,
      }))
  : NAVIGATION;
---

<header class={headerClass}>
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2">
      <span class="font-serif text-xl font-semibold text-foreground">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
      {
        allNavItems.map((item) => {
          const isActive = current === item.to || (item.to !== "/" && current.startsWith(item.to));
          return (
            <a
              href={item.to}
              class={`text-sm font-medium transition-colors ${
                isActive ? activeClass : inactiveClass
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        type="button"
        class={iconClass}
        aria-label="Toggle dark mode"
      >
        <Icon name="sun" class="h-4 w-4 hidden dark:block" />
        <Icon name="moon" class="h-4 w-4 block dark:hidden" />
      </button>

      <!-- Mobile drawer menu trigger -->
      <button
        id="mobile-menu-trigger"
        type="button"
        class={`md:hidden ${iconClass}`}
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-16 hidden border-b border-border/60 bg-background/95 p-6 backdrop-blur-lg md:hidden shadow-xl"
  >
    <nav class="flex flex-col space-y-4" aria-label="Mobile navigation">
      {
        allNavItems.map((item) => {
          const isActive = current === item.to || (item.to !== "/" && current.startsWith(item.to));
          return (
            <a
              href={item.to}
              class={`text-lg font-medium transition-colors ${
                isActive ? "text-primary font-semibold" : "text-muted-foreground hover:text-foreground"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  // Dark mode theme toggle logic
  const themeToggle = document.getElementById("theme-toggle");
  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }

  // Mobile menu toggle logic
  const trigger = document.getElementById("mobile-menu-trigger");
  const menu = document.getElementById("mobile-menu");

  if (trigger && menu) {
    trigger.addEventListener("click", () => {
      const isExpanded = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", (!isExpanded).toString());
      menu.classList.toggle("hidden");
    });
  }
</script>
