---
import Icon from "./Icon.astro";
import { SITE, NAVIGATION, SOCIAL_LINKS } from "../config/theme.config.ts";

const { flush = false } = Astro.props;
---

<footer class:list={[flush ? "mt-0" : "mt-24", "border-t border-border/60 bg-background"]}>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-3">
    <div class="md:col-span-2">
      <div class="font-serif text-2xl font-bold">{SITE.name}</div>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">
        {SITE.description}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-muted-foreground">
        {
          SOCIAL_LINKS.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
              class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border/60 bg-muted/30 transition-all hover:border-primary hover:bg-primary/10 hover:text-primary"
            >
              <Icon name={link.icon} class="h-4 w-4" />
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-primary">Sections</div>
      <ul class="mt-4 space-y-2.5 text-sm font-medium">
        {
          NAVIGATION.map((item) => (
            <li>
              <a href={item.to} class="text-muted-foreground hover:text-foreground transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-5 py-6 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <div>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</div>
      <div>Melodic Rock Project &bull; Netherlands</div>
    </div>
  </div>
</footer>
